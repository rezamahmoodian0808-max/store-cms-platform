# Application Environment Configuration
APP_ENV=production
HOST=0.0.0.0
PORT=8000
SITE_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-secure-random-key-in-production-min32chars!
DATABASE_PATH=app.db

# SSL & Security Configuration
# Set FORCE_HTTPS=true when deploying behind an SSL reverse proxy (Nginx, Caddy, Cloudflare)
FORCE_HTTPS=false

# Default Admin Credentials for initial seeding
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
ADMIN_NAME="Site Administrator"
